{
  "geode": "5.7.1",

  "gd": {
    "win": "2.2081",
    "mac": "2.2081"
  },

  "version": "1.0.0",

  "id": "kristarune.lists-integrations",

  "name": "ListsIntegrations",

  "developer": "Kristarune",

  "description": "Adds demon list badges from AREDL, NARLL, Pointercrate, and custom APIs directly into Geometry Dash level cells.",

  "repository": "https://github.com/Kristarune/list-integration",

  "tags": [
    "interface",
    "online",
    "utility"
  ],

  "dependencies": {
    "geode.node-ids": ">=1.0.0"
  },

  "settings": {
    "show-badges": {
      "name": "Show List Badges",
      "description": "Display demon list badges in level cells.",
      "type": "bool",
      "default": true
    },

    "show-rank": {
      "name": "Show Rank",
      "description": "Display the level's position on the list.",
      "type": "bool",
      "default": true
    },

    "badge-position": {
      "name": "Badge Position",
      "description": "Where badges appear on level cells.",
      "type": "string",
      "default": "Top Right",
      "enum": [
        "Top Right",
        "Top Left",
        "Bottom Right",
        "Bottom Left"
      ]
    },

    "cache-duration": {
      "name": "Cache Duration",
      "description": "Minutes before refreshing list data.",
      "type": "int",
      "default": 15
    },

    "aredl-enabled": {
      "name": "Enable AREDL",
      "type": "bool",
      "default": true
    },

    "aredl-url": {
      "name": "AREDL API URL",
      "type": "string",
      "default": "https://api.aredl.net/api/aredl/levels"
    },

    "narll-enabled": {
      "name": "Enable NARLL",
      "type": "bool",
      "default": true
    },

    "narll-url": {
      "name": "NARLL API URL",
      "type": "string",
      "default": "https://api.narll.org/list"
    },

    "demonlist-enabled": {
      "name": "Enable Pointercrate",
      "type": "bool",
      "default": true
    },

    "demonlist-url": {
      "name": "Pointercrate API URL",
      "type": "string",
      "default": "https://pointercrate.com/api/v2/demons/listed"
    },

    "custom-list-enabled": {
      "name": "Enable Custom List",
      "type": "bool",
      "default": false
    },

    "custom-list-name": {
      "name": "Custom List Name",
      "type": "string",
      "default": "Custom List"
    },

    "custom-list-url": {
      "name": "Custom List API URL",
      "type": "string",
      "default": ""
    }
  }
}
